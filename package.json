{
  "name": "code-by-barca-ui",
  "version": "1.0.0",
  "description": "UI knihovna pro code-by-barca.cz – tmavý „geeky“ design se žlutým akcentem (React, TypeScript, bez závislosti na Tailwindu).",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "dark",
    "code-by-barca",
    "next"
  ],
  "license": "MIT",
  "author": "Barbora Šanderová",
  "homepage": "https://code-by-barca.cz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Barbora-san/code-by-barca-ui.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "prepublishOnly": "npm run typecheck && npm run test:unit",
    "demo:build": "node scripts/gen-docs.mjs && esbuild demo/main.tsx --bundle --minify --jsx=automatic --loader:.css=css --define:process.env.NODE_ENV=\\\"production\\\" --outdir=demo/dist && node scripts/copy-demo.mjs",
    "demo": "npm run demo:build && npx --yes serve demo/dist",
    "docs": "node scripts/gen-docs.mjs",
    "test": "npm run build && vitest run && npm run demo:build && playwright test",
    "test:unit": "npm run build && vitest run",
    "test:e2e": "npm run demo:build && playwright test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
