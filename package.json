{
  "name": "code-by-barca-ui",
  "version": "0.1.0",
  "description": "UI knihovna pro code-by-barca.cz – tmavý „geeky“ design se žlutým akcentem (React, TypeScript, bez závislosti na Tailwindu).",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "dark",
    "code-by-barca",
    "next"
  ],
  "license": "MIT",
  "author": "Barbora Šanderová",
  "homepage": "https://code-by-barca.cz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Barbora-san/code-by-barca-ui.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "demo:build": "esbuild demo/main.tsx --bundle --minify --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outdir=demo/dist && node scripts/copy-demo.mjs",
    "demo": "npm run demo:build && npx --yes serve demo/dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}